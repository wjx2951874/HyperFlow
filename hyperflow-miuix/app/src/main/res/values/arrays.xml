<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LSPosed 预勾选作用域（遗留模块机制，兼容经典 LSPosed；新版 Vector 读 META-INF/xposed/scope.list，见 resources 目录）。
         系统框架双标识：android=经典 LSPosed / system=新版 Vector（JingMatrix 分支），两个都写保证两边都认。
         电话仅 com.android.incallui（HookCallVoipNotify 所在进程），其余电话进程无 hook 不列入。
         本 App（com.hyperflowplus）自身进程无需被 hook，不再列入推荐作用域（LSPosed 中勾不了也属正常）。 -->
    <string-array name="xposedscope">
        <item>com.milink.service</item>
        <item>com.xiaomi.trustservice</item>
        <item>com.xiaomi.mirror</item>
        <item>com.android.incallui</item>
        <item>android</item>
        <item>system</item>
    </string-array>
</resources>
